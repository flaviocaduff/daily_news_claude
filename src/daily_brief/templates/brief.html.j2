<!doctype html>
<html lang="{{ lang_code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="referrer" content="no-referrer">
<title>{{ title }} · {{ b.now.strftime('%Y-%m-%d') }}</title>
<style>
:root{
  --bg:#f7f6f3;--card:#fff;--text:#1d1d1f;--muted:#6b6b70;--line:#e6e4df;
  --accent:#b4441c;--accent-soft:#f6e7df;--chip:#efede8;
}
@media (prefers-color-scheme:dark){:root{
  --bg:#121214;--card:#1c1c1f;--text:#ececef;--muted:#9a9aa2;--line:#2c2c31;
  --accent:#f0895a;--accent-soft:#2e211b;--chip:#26262a;
}}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--text);
  font:16px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif}
.wrap{max-width:760px;margin:0 auto;padding:24px 16px 48px}
header.top h1{margin:0;font-size:1.9rem;letter-spacing:-.02em}
header.top .date{color:var(--muted);margin-top:2px}
nav.toc{display:flex;flex-wrap:wrap;gap:6px;margin:16px 0 8px}
nav.toc a{font-size:.8rem;text-decoration:none;color:var(--text);background:var(--chip);
  padding:3px 10px;border-radius:999px;white-space:nowrap}
nav.toc a:hover{background:var(--accent-soft);color:var(--accent)}
h2{font-size:.8rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);
  margin:32px 0 10px;padding-bottom:6px;border-bottom:1px solid var(--line)}
h2 .n{font-weight:400}
.item{display:flex;gap:14px;padding:12px 0;border-bottom:1px solid var(--line)}
.item:last-child{border-bottom:0}
.thumb{flex:0 0 88px;height:66px;border-radius:8px;overflow:hidden;background:var(--chip)}
.thumb img{width:100%;height:100%;object-fit:cover;display:block}
.body{min-width:0;flex:1}
.body h3{margin:0 0 3px;font-size:1rem;line-height:1.35}
.body h3 a{color:var(--text);text-decoration:none}
.body h3 a:hover{color:var(--accent)}
.body p{margin:0;color:var(--text);opacity:.88;font-size:.94rem}
.meta{margin-top:4px;font-size:.78rem;color:var(--muted)}
.meta a{color:var(--accent);text-decoration:none}
.top3{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:4px 16px;margin-top:20px}
.top3 h2{margin-top:14px;color:var(--accent);border:0;padding:0}
.top3 .item{gap:16px}
.top3 .thumb{flex-basis:120px;height:84px}
.top3 .rank{font-weight:700;color:var(--accent);margin-right:4px}
footer{margin-top:40px;font-size:.8rem;color:var(--muted)}
footer a{color:var(--muted)}
@media (max-width:480px){
  .thumb{flex-basis:72px;height:56px}
  .top3 .thumb{flex-basis:88px;height:66px}
  header.top h1{font-size:1.6rem}
}
</style>
</head>
<body>
<div class="wrap">
<header class="top">
  <h1>{{ title }}</h1>
  <div class="date">{{ date_long }} · {{ b.item_count }} stories</div>
</header>

{% macro row(it, rank=None) -%}
<article class="item">
  {% if it.image %}<div class="thumb"><img src="{{ it.image }}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.parentNode.remove()"></div>{% endif %}
  <div class="body">
    <h3>{% if rank %}<span class="rank">{{ rank }}.</span>{% endif %}<a href="{{ it.link }}" target="_blank" rel="noopener">{{ it.display_headline() }}</a></h3>
    <p>{{ it.display_summary() }}</p>
    <div class="meta">{{ it.source_name }}{% if it.also_in %} · also in {{ it.also_in | join(', ') }}{% endif %} · <a href="{{ it.link }}" target="_blank" rel="noopener">Read →</a></div>
  </div>
</article>
{%- endmacro %}

{% if b.top %}
<section class="top3" id="top">
  <h2>Top {{ b.top | length }}</h2>
  {% for it in b.top %}{{ row(it, loop.index) }}{% endfor %}
</section>
{% endif %}

{% if b.sections | length > 1 %}
<nav class="toc">
  {% for src, items in b.sections %}<a href="#{{ src.id | slug }}">{{ src.name }}</a>{% endfor %}
</nav>
{% endif %}

{% for src, items in b.sections %}
<section id="{{ src.id | slug }}">
  <h2>{{ src.name }} <span class="n">· {{ items | length }}</span></h2>
  {% for it in items %}{{ row(it) }}{% endfor %}
</section>
{% endfor %}

<footer>
  {% if b.empty_sources %}<p>No new items: {{ b.empty_sources | join(', ') }}.</p>{% endif %}
  {% if b.failed_sources %}<p>Could not fetch: {{ b.failed_sources | join(', ') }}.</p>{% endif %}
  {% if not b.llm %}<p>Summaries: source teasers (LLM disabled).</p>{% endif %}
  <p>Generated {{ generated }}. {% if archive_dates %}Archive:
  {% for d in archive_dates %}<a href="archive/{{ d }}.html">{{ d }}</a>{% if not loop.last %} · {% endif %}{% endfor %}{% endif %}</p>
</footer>
</div>
</body>
</html>
