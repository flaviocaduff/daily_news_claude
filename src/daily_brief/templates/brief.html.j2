<!doctype html>
<html lang="{{ lang_code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="referrer" content="no-referrer">
<meta name="robots" content="noindex">
{% if not b.llm %}<meta name="brief-fallback" content="teasers">{% endif %}
<title>{{ title }} · {{ b.now.strftime('%Y-%m-%d') }}</title>
<style>
:root{
  --bg:#f4f2ee;--card:#fff;--text:#16161a;--muted:#5f5f66;--line:#e3e0da;
  --accent:#c2410c;--shadow:0 1px 2px rgba(0,0,0,.05),0 4px 14px rgba(0,0,0,.06);
  --ph-l:46%;--ph-s:58%;
}
@media (prefers-color-scheme:dark){:root{
  --bg:#0f0f11;--card:#1a1a1e;--text:#f1f1f3;--muted:#a3a3ad;--line:#2a2a30;
  --accent:#fb923c;--shadow:0 1px 2px rgba(0,0,0,.4);--ph-l:34%;--ph-s:45%;
}}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--text);
  font:16px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif}
a{color:inherit;text-decoration:none}
.wrap{max-width:1120px;margin:0 auto;padding:28px 16px 56px}

/* masthead */
.mast{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;flex-wrap:wrap;
  padding-bottom:14px;border-bottom:3px solid var(--text)}
.mast .kicker{font-size:.8rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--accent)}
.mast h1{margin:2px 0 0;font-size:clamp(1.8rem,4.5vw,2.8rem);line-height:1.05;font-weight:850;letter-spacing:-.03em}
.mast .stats{color:var(--muted);font-size:.9rem}

/* thumbnails + placeholders */
.img{position:relative;aspect-ratio:16/9;overflow:hidden;
  background:linear-gradient(135deg,hsl(var(--h) var(--ph-s) var(--ph-l)),hsl(calc(var(--h) + 40) var(--ph-s) calc(var(--ph-l) - 12%)))}
.img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.img .ph{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:12px;
  color:rgba(255,255,255,.92);font-weight:800;font-size:1.05rem;letter-spacing:-.01em;text-align:center}

/* cards */
.card{display:flex;flex-direction:column;background:var(--card);border-radius:14px;overflow:hidden;
  box-shadow:var(--shadow);border:1px solid var(--line);transition:transform .15s ease,box-shadow .15s ease}
.card:hover{transform:translateY(-2px);box-shadow:0 6px 22px rgba(0,0,0,.12)}
.card .body{padding:12px 14px 14px;display:flex;flex-direction:column;gap:6px;flex:1}
.tag{align-self:flex-start;font-size:.68rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;
  color:hsl(var(--h) 70% 38%);}
@media (prefers-color-scheme:dark){.tag{color:hsl(var(--h) 80% 70%)}}
.card h3{margin:0;font-size:1.08rem;line-height:1.28;font-weight:780;letter-spacing:-.012em}
.card:hover h3{color:var(--accent)}
.card p{margin:0;color:var(--muted);font-size:.9rem;line-height:1.45}
.also{font-size:.75rem;color:var(--muted);margin-top:auto;padding-top:4px}
.clamp3{display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}

/* Top N */
.top{display:grid;grid-template-columns:1.55fr 1fr;grid-template-rows:auto auto;gap:18px;margin-top:22px}
.top .card:first-child{grid-row:span 2}
.top .card:first-child h3{font-size:clamp(1.4rem,2.6vw,1.95rem);line-height:1.15;font-weight:850;letter-spacing:-.025em}
.top .card:first-child p{font-size:1.02rem}
.top .card:first-child .img{aspect-ratio:auto;flex:1;min-height:240px}
.top .card:first-child .body{flex:0 0 auto;padding:16px 20px 20px}
.top .card:not(:first-child) h3{font-size:1.2rem}
.top .rank{color:var(--accent);margin-right:6px}

/* sections */
section.sec{margin-top:44px}
.sec h2{display:flex;align-items:baseline;gap:10px;margin:0 0 16px;font-size:1.55rem;font-weight:850;letter-spacing:-.02em}
.sec h2::before{content:"";width:6px;height:1.05em;border-radius:3px;background:hsl(var(--h) 65% 50%);align-self:center}
.sec h2 .n{font-size:.85rem;font-weight:600;color:var(--muted)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:18px}

footer{margin-top:48px;padding-top:14px;border-top:1px solid var(--line);font-size:.8rem;color:var(--muted)}
footer a{text-decoration:underline}
@media (max-width:760px){
  .top{grid-template-columns:1fr}
  .top .card:first-child{grid-row:auto}
  .top .card:first-child .img{aspect-ratio:16/10;flex:none;min-height:0}
}

/* story view: opens when a card is tapped (#s-<id>), no JS needed */
.story{display:none}
.story:target{display:block;position:fixed;inset:0;z-index:10;overflow-y:auto;background:var(--bg)}
.story .in{max-width:720px;margin:0 auto;padding:20px 16px 56px}
.story .back{display:inline-block;margin-bottom:18px;font-weight:700;color:var(--accent)}
.story h2{margin:6px 0 14px;font-size:clamp(1.5rem,4vw,2.1rem);line-height:1.15;font-weight:850;letter-spacing:-.02em}
.story img{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:12px;margin-bottom:16px;background:var(--line)}
.story ul{margin:0 0 18px;padding-left:1.2em;font-size:1.08rem}
.story li{margin:0 0 10px}
.story .gist{font-size:1.15rem;line-height:1.5;margin:0 0 16px}
.story .why{margin:0 0 18px;padding:10px 14px;border-left:3px solid var(--accent);background:color-mix(in srgb,var(--accent) 8%,transparent);border-radius:0 8px 8px 0}
.story .note{font-size:.85rem;color:var(--muted)}
.story .srcs{margin-top:22px;padding-top:12px;border-top:1px solid var(--line);font-size:.9rem;color:var(--muted)}
.story .srcs a{text-decoration:underline;color:var(--text)}
body:has(.story:target){overflow:hidden}
.fallback{margin:14px 0 0;padding:10px 14px;border-left:3px solid var(--accent);background:color-mix(in srgb,var(--accent) 8%,transparent);border-radius:0 8px 8px 0;font-size:.9rem}
.pod{display:flex;align-items:center;gap:12px;margin:0 0 18px;font-size:13px;color:var(--muted)}
.pod audio{flex:1;min-width:0;height:36px}

/* EN/DE toggle: a hidden checkbox (first child of body) switches every .en/.de pair; works without JS */
#de:not(:checked) ~ * .de,#de:checked ~ * .en{display:none}
.lang{display:inline-flex;border:1px solid var(--line);border-radius:999px;overflow:hidden;cursor:pointer;
  font-size:.78rem;font-weight:800;letter-spacing:.06em;user-select:none;-webkit-tap-highlight-color:transparent}
.lang b{padding:5px 11px;color:var(--muted)}
#de:not(:checked) ~ * .lang .le,#de:checked ~ * .lang .ld{background:var(--text);color:var(--bg)}
.mast .right{display:flex;flex-direction:column;align-items:flex-end;gap:8px}
.story .bar{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}
.story .bar .back{margin:0}
</style>
</head>
<body>
<input type="checkbox" id="de" hidden>
{% if has_de %}<script>(function(){var c=document.getElementById("de");function s(){document.documentElement.lang=c.checked?"de":"en"}
try{c.checked=localStorage.getItem("lang")==="de"}catch(e){}s();
c.addEventListener("change",function(){s();try{localStorage.setItem("lang",c.checked?"de":"en")}catch(e){}})})()</script>{% endif %}
{% macro t(en, de) -%}
{% if de %}<span class="en">{{ en }}</span><span class="de" lang="de">{{ de }}</span>{% else %}{{ en }}{% endif %}
{%- endmacro %}
{% macro toggle() -%}
{% if has_de %}<label class="lang" for="de" title="English / Deutsch"><b class="le">EN</b><b class="ld">DE</b></label>{% endif %}
{%- endmacro %}
<div class="wrap">
<header class="mast">
  <div>
    <div class="kicker">{{ title }}</div>
    <h1>{{ t(date_long, date_long_de if has_de else '') }}</h1>
  </div>
  <div class="right">{{ toggle() }}
  <div class="stats">{{ b.item_count }} {{ t('stories', 'Meldungen') }} · {{ b.sections | length }} {{ t('sections', 'Rubriken') }}</div></div>
</header>

{% if not b.llm %}
<p class="fallback">Short version: Claude was not available for this build, so these are the sources' own teasers,
  without ranking, plain-language panels or German. The next automatic run replaces it with the full brief.</p>
{% endif %}
{% if b.audio %}
<div class="pod"><span>{{ t('Listen (German)', 'Anhören') }} · {{ (b.audio_seconds // 60) | int }}:{{ '%02d' | format((b.audio_seconds % 60) | int) }}</span>
  <audio controls preload="none" src="{{ b.audio }}"></audio></div>
{% endif %}

{% macro card(it, rank=None) -%}
<a class="card" href="#s-{{ it.uid }}" style="--h:{{ it.section | hue }}">
  <div class="img">
    <div class="ph">{{ it.link | domain }}</div>
    {% if it.image %}<img src="{{ it.image }}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()">{% endif %}
  </div>
  <div class="body">
    <span class="tag">{{ it.source_name }}</span>
    <h3 class="{{ '' if rank == 1 else 'clamp3' }}">{% if rank %}<span class="rank">{{ rank }}</span>{% endif %}{{ t(it.display_headline(), it.de.headline) }}</h3>
    <p class="{{ '' if rank == 1 else 'clamp3' }}">{{ t(it.display_summary(), it.de.summary) }}</p>
    {% if it.also_in %}<div class="also">{{ t('Also in', 'Auch in') }} {{ it.also_in | join(', ') }}</div>{% endif %}
  </div>
</a>
{%- endmacro %}

{% if b.top %}
<div class="top">
  {% for it in b.top %}{{ card(it, loop.index) }}{% endfor %}
</div>
{% endif %}

{% for sec, items in b.sections %}
<section class="sec" id="{{ sec.name | slug }}" style="--h:{{ sec.name | hue }}">
  <h2>{{ sec.name }} <span class="n">{{ items | length }}</span></h2>
  <div class="grid">
    {% for it in items %}{{ card(it) }}{% endfor %}
  </div>
</section>
{% endfor %}

<footer>
  {% if b.empty_sources %}<p>{{ t('No new items:', 'Keine neuen Meldungen:') }} {{ b.empty_sources | join(', ') }}.</p>{% endif %}
  {% if b.failed_sources %}<p>{{ t('Could not fetch:', 'Nicht abrufbar:') }} {{ b.failed_sources | join(', ') }}.</p>{% endif %}
  {% if not b.llm %}<p>Summaries: source teasers (LLM disabled).</p>{% endif %}
  <p>{{ t('Generated', 'Erstellt') }} {{ generated }}. {% if archive_dates %}{{ t('Archive:', 'Archiv:') }}
  {% for d in archive_dates %}<a href="archive/{{ d }}.html">{{ d }}</a>{% if not loop.last %} · {% endif %}{% endfor %}{% endif %}</p>
</footer>
</div>

{% for it in b.stories %}
<article class="story" id="s-{{ it.uid }}" style="--h:{{ it.section | hue }}">
  <div class="in">
    <div class="bar"><a class="back" href="#" onclick="if(history.length>1){history.back();return false}">{{ t('← Back', '← Zurück') }}</a>{{ toggle() }}</div>
    <div><span class="tag">{{ it.source_name }}</span></div>
    <h2>{{ t(it.display_headline(), it.de.headline) }}</h2>
    {% if it.image %}<img src="{{ it.image }}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()">{% endif %}
    {% if it.points %}
    {% if it.gist %}<p class="gist">{{ t(it.gist, it.de.gist) }}</p>{% endif %}
    {% if it.de.points %}
    <ul class="en">{% for p in it.points %}<li>{{ p }}</li>{% endfor %}</ul>
    <ul class="de" lang="de">{% for p in it.de.points %}<li>{{ p }}</li>{% endfor %}</ul>
    {% else %}
    <ul>{% for p in it.points %}<li>{{ p }}</li>{% endfor %}</ul>
    {% endif %}
    {% if it.why %}<p class="why"><b>{{ t('Why it matters:', 'Warum es wichtig ist:') }}</b> {{ t(it.why, it.de.why) }}</p>{% endif %}
    {% else %}
    <p>{{ t(it.display_summary(), it.de.summary) }}</p>
    {% endif %}
    {% if it.points_from_preview %}<p class="note">{{ t('Based on the preview only: the full article could not be read (paywall or blocked).', 'Nur aus der Vorschau: Der ganze Artikel war nicht lesbar (Paywall oder gesperrt).') }}</p>{% endif %}
    <div class="srcs">{{ t('Sources:', 'Quellen:') }}
      {% for src in [it] + it.dupes %}<a href="{{ src.link }}" target="_blank" rel="noopener">{{ src.source_name }}</a>{% if not loop.last %} · {% endif %}{% endfor %}
    </div>
  </div>
</article>
{% endfor %}
</body>
</html>
