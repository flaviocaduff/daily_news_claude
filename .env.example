# Required for summaries (without it, run with --no-llm)
ANTHROPIC_API_KEY=

# Notifications: a channel is used only when its variables are set
NTFY_TOPIC=            # e.g. a long random string; subscribe to it in the ntfy app
NTFY_SERVER=https://ntfy.sh
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Public URL of the published page, used in notifications
SITE_URL=
